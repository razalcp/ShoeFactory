    <!-- Define updateCart function globally -->
    <script>
        // Global updateCart function
        window.updateCart = function() {
            try {
                // Redirect to cart page
                window.location.href = '/cart';
            } catch (error) {
                console.error('Error updating cart:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to redirect to cart. Please try again.',
                    timer: 3000,
                    showConfirmButton: false
                });
            }
        };
    </script>
    
    <script>


        function deleteconfirm() {

            Swal.fire({
                title: "Are you sure?",
                text: "You want to delete this Address!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const del = await deleteAddress();
                    if (del) {
                        Swal.fire({
                            title: "Deleted Successfully!",
                            text: "The product has been deleted.",
                            icon: "success"
                        }).then(() => {
                            location.reload()
                        })

                    }
                } else {
                    Swal.fire({
                        title: "Product deletion Cancelled!",
                        text: "The product addition  has been cancelled.",
                        icon: "success"
                    });
                }
            });
        }


        async function deleteAddress() {
            const addressid = document.getElementById('addresshiddenfield').value
            const button = document.getElementsByClassName('removebtn')

            url = `/deleteAddress?addressId=${addressid}`
            const result = await fetch(url)
            if (result.status === 200) {
                console.log("data deleted");
                return true
            }
        }




    </script>

    <script>
        // Remove item functionality - same as cart page
        document.querySelectorAll('.removeBtn').forEach(btn => {
            btn.addEventListener('click', async function(event) {
                const result = await Swal.fire({
                    title: "Are you sure?",
                    text: "You want to delete this Product!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete!"
                });
                
                if (result.isConfirmed) {
                    const productId = this.dataset.id;
                    const variantId = this.dataset.variantId;
                    
                    try {
                        const url = `/deleteCartItem?productid=${productId}&variantId=${variantId}`;
                        const fetchResult = await fetch(url);
                        
                        if (fetchResult) {
                            const buttonClicked = event.target;
                            buttonClicked.parentElement.parentElement.remove();
                            
                            Swal.fire({
                                title: "Deleted Successfully!",
                                text: "The product has been deleted.",
                                icon: "success"
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                title: "Product deletion not Possible!",
                                text: "Error in deleting product. Please try after some time!!",
                                icon: "error"
                            });
                        }
                    } catch (error) {
                        console.error('Error removing item:', error);
                        Swal.fire({
                            title: "Product deletion not Possible!",
                            text: "Error in deleting product. Please try after some time!!",
                            icon: "error"
                        });
                    }
                }
            });
        });

