<%-include('../userLayouts/userHeader') %>

    <div class="checkout_area pt-80">
        <div class="container">

            <div class="f_cart_area pt-110 mb-100">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-8 col-lg-8 col-md-12">
                            <div class="cart_table">
                                <table>
                                    <tr>
                                        <td>Product Image</td>
                                        <td>Product Name</td>

                                        <td>Action</td>

                                    </tr>
                                    <tbody>
                                        <% if(locals.cartData){ %>
                                            <%locals.cartData.forEach(el=>{%>
                                                <% let variant = null; %>
                                                <% if(el.productId && el.productId.variants && el.productId.variants.id(el.variantId)) { %>
                                                    <% variant = el.productId.variants.id(el.variantId); %>
                                                <% } %>
                                                <tr class="max-width-set">
                                                    <td>
                                                        <% if(variant && variant.imageurl && variant.imageurl.length > 0) { %>
                                                            <img src="<%= imageUrl(variant.imageurl[0]) %>" alt="">
                                                        <% } else { %>
                                                            <img src="/public/assets/img/product/placeholder.jpg" alt="">
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <%= el.productId.producttitle %> <span>x<%=el.quantity%></span>
                                                    </td>
                                                    <td>
                                                        <div class="variant-info">
                                                            <span class="badge bg-info">Size: <%= el.size %></span>
                                                            <span class="badge bg-secondary">Color: <%= el.color %></span>
                                                        </div>
                                                    </td>
                                                    <td>₹<%= variant ? variant.price : 0 %></td>
                                                    <td><button type="button" class="btn btn-danger removeBtn"
                                                            data-variant-id="<%=el.variantId%>"
                                                            data-id="<%=el.productId._id%>">Remove</button></td>
                                                </tr>
                                                <input type="hidden" value="<%=el.productId._id%>" class="hiddenField">
                                                <input type="hidden" value="<%=el.variantId%>" class="hiddenVariantField">
                                                <% }) %>
                                            <% } %>

                                    </tbody>

                                    <%if(locals.cart){%>
                                        <input type="hidden" id="cartidhidden" value="<%=cart._id%>">
                                        <%}%>
                                        <tfoot>
                                <tr class="design-footer">
                                    <td colspan="5" class="text-end">
                                        <button type="button" onclick="updateCart()" class="btn btn-secondary">Update Cart</button>
                                    </td>
                                </tr>
                            </tfoot>
                                </table>
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-12">
                            <div class="cart__acount">
                                <h5>Cart totals:</h5>
                                <% if(locals.cart) { %>

                                    <table>


                                        <tr class="first-child">
                                            <td>Price</td>
                                            <td id="">₹<%= cartTotal || 0 %>
                                            </td>
                                            
                                        </tr>
                                        <tr class="first-child">
                                            <td>Discount</td>
                                            <td id="disco">0
                                            </td>
                                            
                                        </tr>
                                        <tr class="first-child">
                                            <td>Total Price</td>
                                            <td id="subTotal">₹<%= cartTotal || 0 %>
                                                
                                            </td>
                                            
                                        </tr>
                                        <tr id="discountMessage" style="color: darkgreen;">
                                            
                                        </tr>
                                      
                                    </table>

                                    <% } %>
                                        <br>
                                        <h5>Available Coupons:</h5>
                                        <% 
                                            const usedCouponsList = (locals.userdata && locals.userdata.couponApplied) ? locals.userdata.couponApplied.map(String) : [];
                                            const availableCoupons = (locals.coupons || []).filter(c => !usedCouponsList.includes(c._id.toString()) && !usedCouponsList.includes(c.couponCode));
                                        %>
                                        <% if(availableCoupons && availableCoupons.length > 0){ %>
                                            <table>
                                                <% availableCoupons.forEach(ele=>{ %>
                                                    <tr>
                                                        <td class="couponName">
                                                            <%=ele.couponCode%>
                                                        </td>
                                                        <td><button class="styled-button"
                                                                onclick="couponApply('<%=ele._id%>')">Apply</button></td>
                                                    </tr>
                                                <% }) %>
                                            </table>
                                        <% } else { %>
                                            <p class="text-muted" style="font-size: 14px; margin-top: 10px;">No available coupons</p>
                                        <% } %>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

