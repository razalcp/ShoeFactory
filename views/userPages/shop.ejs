<%- include('../userLayouts/userHeader.ejs') %>

    <!-- breadcrumb area start -->
    <div class="page-layout" data-background="assets/img/slider/shop.jpg">
        <div class="container">
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                    <div class="breadcrumb-area text-center">
                        <h2 class="page-title">shop</h2>
                        <div class="breadcrumb-menu">
                            <nav aria-label="breadcrumb">
                                <!-- <ol class="breadcrumb justify-content-center">
                                    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                                    <li class="breadcrumb-item"><a href="shop.html">shop</a></li>
                                </ol> -->
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- breadcrumb area end -->

    <!-- shop page start -->
    <div class="shop-page pt-85">
        <div class="container">
            <!-- Search Bar Section -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="search-bar-section">
                        <div class="input-group">
                            <input type="text" id="searchInput" class="form-control form-control-lg"
                                placeholder="Search by brand name, product name, or description...">
                            <button class="btn btn-primary" type="button" onclick="applyFilters()">
                                <i class="fal fa-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-3 col-lg-4 col-md-12">
                    <div class="sidebar">
                        <!-- Filters Section -->
                        <div class="sidebar-widget">
                            <h3 class="widget-title">Filters</h3>

                            <!-- Brand Filter -->
                            <div class="filter-section mb-4">
                                <h5>Brand</h5>
                                <div class="brand-filters">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="Nike" id="brandNike"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="brandNike">Nike</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="Puma" id="brandPuma"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="brandPuma">Puma</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="Adidas" id="brandAdidas"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="brandAdidas">Adidas</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Price Range Filter -->
                            <div class="filter-section mb-4">
                                <h5>Price Range</h5>
                                <div class="price-range">
                                    <div class="row">
                                        <div class="col-6">
                                            <input type="number" id="minPrice" class="form-control" placeholder="Min"
                                                min="0" oninput="applyFilters()">
                                        </div>
                                        <div class="col-6">
                                            <input type="number" id="maxPrice" class="form-control" placeholder="Max"
                                                min="0" oninput="applyFilters()">
                                        </div>
                                    </div>
                                    <input type="range" id="priceRange" class="form-range" min="0" max="10000"
                                        step="100" oninput="updatePriceDisplay()">
                                    <div class="d-flex justify-content-between">
                                        <small>₹0</small>
                                        <small id="priceValue">₹5000</small>
                                        <small>₹10000</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Size Filter -->
                            <div class="filter-section mb-4">
                                <h5>Size</h5>
                                <div class="size-filters">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="5" id="size5"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size5">5</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="6" id="size6"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size6">6</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="7" id="size7"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size7">7</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="8" id="size8"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size8">8</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="9" id="size9"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size9">9</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="10" id="size10"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size10">10</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="11" id="size11"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size11">11</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="12" id="size12"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="size12">12</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Color Filter -->
                            <div class="filter-section mb-4">
                                <h5>Color</h5>
                                <div class="color-filters">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="black" id="colorBlack"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorBlack">Black</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="red" id="colorRed"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorRed">Red</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="brown" id="colorBrown"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorBrown">Brown</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="blue" id="colorBlue"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorBlue">Blue</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="white" id="colorWhite"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorWhite">White</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="cream" id="colorCream"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorCream">Cream</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="gray" id="colorGray"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorGray">Gray</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="green" id="colorGreen"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorGreen">Green</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="yellow" id="colorYellow"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorYellow">Yellow</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" value="orange" id="colorOrange"
                                            onchange="applyFilters()">
                                        <label class="form-check-label" for="colorOrange">Orange</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Clear Filters Button -->
                            <div class="filter-section">
                                <button class="btn btn-outline-danger w-100" onclick="clearAllFilters()">
                                    <i class="fal fa-times"></i> Clear All Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-9 col-lg-8 col-md-12 col-sm-12">
                    <!-- Sort Dropdown -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="results-info">
                                    <span id="resultsCount">Showing all products</span>
                                </div>
                                <div class="sort-dropdown">
                                    <select id="sortSelect" class="form-select" onchange="applyFilters()">
                                        <option value="">Sort by</option>
                                        <option value="price-low">Price: Low to High</option>
                                        <option value="price-high">Price: High to Low</option>
                                        <option value="best-selling">Best Selling</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="shop-page-product pt-50 pb-100">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12">
                                <div class="tab-content" id="nav-tabContent">
                                    <div class="tab-pane fade show active" id="nav-home" role="tabpanel"
                                        aria-labelledby="nav-home-tab">
                                        <div class="row">
                                            <%if(product){%>
                                                <% product.forEach((pdt)=> { %>
                                                    <% const pdtSizes=pdt.variants && pdt.variants.length> 0 ? [...new
                                                        Set(pdt.variants.map(v => v.size))] : []; %>
                                                        <% const pdtColors=pdt.variants && pdt.variants.length> 0 ?
                                                            [...new Set(pdt.variants.map(v => v.color))] : []; %>
                                                            <div class="col-xl-6 col-lg-6 col-md-6 mb-4"
                                                                data-brand="<%= pdt.brandId ? pdt.brandId.brandName : 'Unknown' %>"
                                                                data-sizes="<%= pdtSizes.join(',') %>"
                                                                data-colors="<%= pdtColors.join(',') %>">
                                                                <div class="product product-4">
                                                                    <div class="product__thumb">
                                                                        <a
                                                                            href="/userhome/productdetail?id=<%= pdt._id %>">
                                                                            <% if(pdt.variants && pdt.variants.length> 0
                                                                                &&
                                                                                pdt.variants[0].imageurl &&
                                                                                pdt.variants[0].imageurl.length > 1) {
                                                                                %>
                                                                                <img class="product-primary"
                                                                                    src="<%= imageUrl(pdt.variants[0].imageurl[0]) %>"
                                                                                    alt="product_image">
                                                                                <img class="product-secondary"
                                                                                    src="<%= imageUrl(pdt.variants[0].imageurl[1]) %>"
                                                                                    alt="product_image">
                                                                                <% } else if(pdt.imageurl &&
                                                                                    pdt.imageurl.length> 3) { %>
                                                                                    <!-- Fallback for old schema -->
                                                                                    <img class="product-primary"
                                                                                        src="<%= imageUrl(pdt.imageurl[3]) %>"
                                                                                        alt="product_image">
                                                                                    <img class="product-secondary"
                                                                                        src="<%= imageUrl(pdt.imageurl[2]) %>"
                                                                                        alt="product_image">
                                                                                    <% } else if(pdt.imageurl &&
                                                                                        pdt.imageurl.length> 0) { %>
                                                                                        <!-- Fallback for minimal images -->
                                                                                        <img class="product-primary"
                                                                                            src="<%= imageUrl(pdt.imageurl[0]) %>"
                                                                                            alt="product_image">
                                                                                        <img class="product-secondary"
                                                                                            src="<%= imageUrl(pdt.imageurl[0]) %>"
                                                                                            alt="product_image">
                                                                                        <% } else { %>
                                                                                            <!-- Default fallback -->
                                                                                            <img class="product-primary"
                                                                                                src="/public/assets/img/product/1.jpg"
                                                                                                alt="product_image">
                                                                                            <img class="product-secondary"
                                                                                                src="/public/assets/img/product/1.jpg"
                                                                                                alt="product_image">
                                                                                            <% } %>
                                                                        </a>
                                                                        <!-- <div class="product__update">
                                                                <a class="#">new</a>
                                                            </div> -->
                                                                        <div class="product-info mb-10">
                                                                            <div class="product_category">
                                                                                <span>
                                                                                    <%= pdt.brandId ?
                                                                                        pdt.brandId.brandName
                                                                                        : 'Unknown' %>
                                                                                </span>
                                                                            </div>
                                                                            <div class="product_rating">
                                                                                <a href="#"><i
                                                                                        class="fal fa-star start-color"></i></a>
                                                                                <a href="#"><i
                                                                                        class="fal fa-star start-color"></i></a>
                                                                                <a href="#"><i
                                                                                        class="fal fa-star start-color"></i></a>
                                                                                <a href="#"><i
                                                                                        class="fal fa-star"></i></a>
                                                                                <a href="#"><i
                                                                                        class="fal fa-star"></i></a>
                                                                            </div>
                                                                        </div>
                                                                        <div class="product__name">
                                                                            <h4><a
                                                                                    href="/userhome/productdetail?id=<%= pdt._id %>">
                                                                                    <%=pdt.producttitle%>
                                                                                </a></h4>
                                                                            <div class="pro-price">
                                                                                <% if(pdt.variants &&
                                                                                    pdt.variants.length> 0) {
                                                                                    %>
                                                                                    <p class="p-absoulute pr-1">
                                                                                        <span>₹</span>
                                                                                        <%= pdt.variants[0].price %>
                                                                                    </p>
                                                                                    <% } else { %>
                                                                                        <!-- Fallback for old schema -->
                                                                                        <p class="p-absoulute pr-1">
                                                                                            <span>₹</span>
                                                                                            <%= pdt.price %>
                                                                                        </p>
                                                                                        <% } %>
                                                                                            <a class="p-absoulute pr-2"
                                                                                                href="#">add to cart</a>
                                                                            </div>
                                                                        </div>
                                                                        <div class="product__action">
                                                                            <div class="inner__action">
                                                                                <div class="wishlist">
                                                                                    <a href="#"><i
                                                                                            class="fal fa-heart"></i></a>
                                                                                </div>
                                                                                <div class="view">
                                                                                    <a href="javascript:void(0)"><i
                                                                                            class="fal fa-eye"></i></a>
                                                                                </div>
                                                                                <div class="layer">
                                                                                    <a href="#"><i
                                                                                            class="fal fa-layer-group"></i></a>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                                <% }%>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- shop page end -->
    <!-- search area  -->
    <div class="search_area">
        <div class="search_close">
            <span><i class="fal fa-times"></i></span>
