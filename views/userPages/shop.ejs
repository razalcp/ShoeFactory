    <!-- JS here -->
    <script>
        // Store original products data
        let originalProducts = [];
        let filteredProducts = [];
        let searchTimeout;

        // Get products from EJS data and store them
        document.addEventListener('DOMContentLoaded', function () {
            // Get products from the server-side rendered data
            const productElements = document.querySelectorAll('.product');
            originalProducts = Array.from(productElements).map((element, index) => {
                const producttitle = element.querySelector('.product__name h4 a').textContent.trim();

                // Get the actual images from the original product
                const primaryImage = element.querySelector('.product-primary')?.src || '/public/assets/img/product/1.jpg';
                const secondaryImage = element.querySelector('.product-secondary')?.src || '/public/assets/img/product/1.jpg';

                // Extract brand name from the data attribute on the parent container
                const productContainer = element.closest('[data-brand]');
                let brandName = 'Unknown'; // Default
                let productSizes = [];
                let productColors = [];

                if (productContainer) {
                    brandName = productContainer.getAttribute('data-brand');
                    const sizesAttr = productContainer.getAttribute('data-sizes');
                    const colorsAttr = productContainer.getAttribute('data-colors');
                    productSizes = sizesAttr ? sizesAttr.split(',').map(s => s.trim()).filter(Boolean) : [];
                    productColors = colorsAttr ? colorsAttr.split(',').map(c => c.trim().toLowerCase()).filter(Boolean) : [];
                    console.log('Found brand from data attribute:', brandName);
                } else {
                    console.log('No data-brand attribute found, using fallback');
                    // Fallback: assign brands based on index for demo
                    if (index % 3 === 0) {
                        brandName = 'Nike';
                    } else if (index % 3 === 1) {
                        brandName = 'Puma';
                    } else {
                        brandName = 'Adidas';
                    }
                }

                const productData = {
                    _id: element.querySelector('a[href*="productdetail"]').href.split('id=')[1],
                    producttitle: producttitle,
                    price: element.querySelector('.pro-price p').textContent.replace('₹', '').trim(),
                    brandName: brandName,
                    sizes: productSizes,
                    colors: productColors,
                    description: producttitle, // Use title as description
                    primaryImage: primaryImage,
                    secondaryImage: secondaryImage,
                    originalElement: element.outerHTML // Store original HTML for fallback
                };
                return productData;
            });

            // console.log('Products loaded:', originalProducts); // Debug log

            // Load filters from URL parameters
            loadFiltersFromURL();

            // Apply initial filters
            applyFilters();

            // Add event listener to search input
            document.getElementById('searchInput').addEventListener('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(applyFilters, 1000);
            });
        });

        // Apply all filters and search
        function applyFilters() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const selectedBrands = getSelectedValues('brand');
            const selectedSizes = getSelectedValues('size');
            const selectedColors = getSelectedValues('color');
            const minPrice = document.getElementById('minPrice').value;
            const maxPrice = document.getElementById('maxPrice').value;
            const sortBy = document.getElementById('sortSelect').value;

            console.log('Filters applied:', {
                searchTerm,
                selectedBrands,
                selectedSizes,
                selectedColors,
                minPrice,
                maxPrice,
                sortBy
            });

            // Filter products based on criteria
            filteredProducts = originalProducts.filter(product => {
                // Search filter (brand name, product name, description)
                if (searchTerm) {
                    const matchesSearch =
                        product.producttitle.toLowerCase().includes(searchTerm) ||
                        (product.description && product.description.toLowerCase().includes(searchTerm)) ||
                        (product.brandName && product.brandName.toLowerCase().includes(searchTerm));
                    if (!matchesSearch) return false;
                }

                // Brand filter - FIXED: Handle multiple brands correctly
                if (selectedBrands.length > 0) {
                    console.log('Checking brand:', product.brandName, 'against:', selectedBrands);
                    if (!selectedBrands.includes(product.brandName)) {
                        return false;
                    }
                }

                // Size filter
                if (selectedSizes.length > 0) {
                    console.log('Checking sizes:', product.sizes, 'against:', selectedSizes);
                    if (!product.sizes.some(size => selectedSizes.includes(String(size)))) {
                        return false;
                    }
                }

                // Color filter
                if (selectedColors.length > 0) {
                    console.log('Checking colors:', product.colors, 'against:', selectedColors);
                    if (!product.colors.some(color => selectedColors.includes(String(color).toLowerCase()))) {
                        return false;
                    }
                }

                // Price filter - FIXED: Handle edge cases properly
                const minPriceNum = minPrice && minPrice.trim() !== '' ? parseFloat(minPrice) : null;
                const maxPriceNum = maxPrice && maxPrice.trim() !== '' ? parseFloat(maxPrice) : null;
                const productPriceNum = parseFloat(product.price);


                if (minPriceNum !== null && productPriceNum < minPriceNum) {
                    return false;
                }
                if (maxPriceNum !== null && productPriceNum > maxPriceNum) {
                    return false;
                }

                return true;
            });


            // Sort products
            if (sortBy) {
                filteredProducts.sort((a, b) => {
                    switch (sortBy) {
                        case 'price-low':
                            return parseFloat(a.price) - parseFloat(b.price);
                        case 'price-high':
                            return parseFloat(b.price) - parseFloat(a.price);
                        case 'best-selling':
                            // For demo purposes, sort by name (you can implement actual sales data)
                            return a.producttitle.localeCompare(b.producttitle);
                        default:
                            return 0;
                    }
                });
            }

            // Update display
            updateProductDisplay();
            updateResultsCount();
            saveFiltersToURL();
        }

        // Get selected checkbox values
        function getSelectedValues(type) {
            const checkboxes = document.querySelectorAll(`input[type="checkbox"][id^="${type}"]:checked`);
            return Array.from(checkboxes).map(cb => cb.value);
        }

        // Update product display
        function updateProductDisplay() {
            const productContainer = document.querySelector('.tab-pane.active .row');
            if (!productContainer) return;

            if (filteredProducts.length === 0) {
                productContainer.innerHTML = '<div class="col-12 text-center py-5"><h4>No products found</h4><p>Try adjusting your filters</p></div>';
                return;
            }

            // Re-render products with filtered data using original HTML
            let html = '';
            filteredProducts.forEach(product => {
                html += `
                        <div class="col-xl-6 col-lg-6 col-md-6 mb-4">
                            <div class="product product-4">
                                <div class="product__thumb">
                                    <a href="/userhome/productdetail?id=${product._id}">
                                        <img class="product-primary" src="${product.primaryImage}" alt="${product.producttitle}">
                                        <img class="product-secondary" src="${product.secondaryImage}" alt="${product.producttitle}">
                                    </a>
                                    <div class="product-info mb-10">
                                        <div class="product_category">
                                            <span>Shoes, Clothing</span>
                                        </div>
                                        <div class="product_rating">
                                            <a href="#"><i class="fal fa-star start-color"></i></a>
                                            <a href="#"><i class="fal fa-star start-color"></i></a>
                                            <a href="#"><i class="fal fa-star start-color"></i></a>
                                            <a href="#"><i class="fal fa-star"></i></a>
                                            <a href="#"><i class="fal fa-star"></i></a>
                                        </div>
                                    </div>
                                    <div class="product__name">
                                        <h4><a href="/userhome/productdetail?id=${product._id}">${product.producttitle}</a></h4>
                                        <div class="pro-price">
                                            <p class="p-absoulute pr-1"><span>₹</span>${product.price}</p>
                                            <a class="p-absoulute pr-2" href="#">add to cart</a>
                                        </div>
                                    </div>
                                    <div class="product__action">
                                        <div class="inner__action">
                                            <div class="wishlist">
                                                <a href="#"><i class="fal fa-heart"></i></a>
                                            </div>
                                            <div class="view">
                                                <a href="javascript:void(0)"><i class="fal fa-eye"></i></a>
                                            </div>
                                            <div class="layer">
                                                <a href="#"><i class="fal fa-layer-group"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
            });

            productContainer.innerHTML = html;
        }

        // Update results count
        function updateResultsCount() {
            const resultsCount = document.getElementById('resultsCount');
            const total = filteredProducts.length;
            resultsCount.textContent = `Showing ${total} product${total !== 1 ? 's' : ''}`;
        }

        // Clear all filters
        function clearAllFilters() {
            // Clear search
            document.getElementById('searchInput').value = '';

            // Clear all checkboxes
            document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);

            // Clear price range
            document.getElementById('minPrice').value = '';
            document.getElementById('maxPrice').value = '';
            document.getElementById('priceRange').value = 5000;
            document.getElementById('priceValue').textContent = '₹5000';

            // Clear sort
            document.getElementById('sortSelect').value = '';

            // Apply filters
            applyFilters();
        }

        // Update price display for range slider
        function updatePriceDisplay() {
            const priceRange = document.getElementById('priceRange');
            const priceValue = document.getElementById('priceValue');
            const minPrice = document.getElementById('minPrice');
            const maxPrice = document.getElementById('maxPrice');

            const rangeValue = parseInt(priceRange.value);
            priceValue.textContent = `₹${rangeValue}`;

            // Set min to 0 and max to slider value
            minPrice.value = 0;
            maxPrice.value = rangeValue;

            // Auto-apply filters when slider moves
            applyFilters();
        }

        // Save filters to URL
        function saveFiltersToURL() {
            const params = new URLSearchParams();

            const search = document.getElementById('searchInput').value;
            if (search) params.set('search', search);

            const brands = getSelectedValues('brand');
            if (brands.length > 0) params.set('brands', brands.join(','));

            const sizes = getSelectedValues('size');
            if (sizes.length > 0) params.set('sizes', sizes.join(','));

            const colors = getSelectedValues('color');
            if (colors.length > 0) params.set('colors', colors.join(','));

            const minPrice = document.getElementById('minPrice').value;
            if (minPrice) params.set('minPrice', minPrice);

            const maxPrice = document.getElementById('maxPrice').value;
            if (maxPrice) params.set('maxPrice', maxPrice);

            const sortBy = document.getElementById('sortSelect').value;
            if (sortBy) params.set('sort', sortBy);

            // Update URL without page reload
            const newURL = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            window.history.replaceState({}, '', newURL);
        }

        // Load filters from URL
        function loadFiltersFromURL() {
            const params = new URLSearchParams(window.location.search);

            const search = params.get('search');
            if (search) document.getElementById('searchInput').value = search;

            const brands = params.get('brands');
            if (brands) {
                brands.split(',').forEach(brand => {
                    const checkbox = document.getElementById(`brand${brand.charAt(0).toUpperCase() + brand.slice(1)}`);
                    if (checkbox) checkbox.checked = true;
                });
            }

            const sizes = params.get('sizes');
            if (sizes) {
                sizes.split(',').forEach(size => {
                    const checkbox = document.getElementById(`size${size}`);
                    if (checkbox) checkbox.checked = true;
                });
            }

            const colors = params.get('colors');
            if (colors) {
                colors.split(',').forEach(color => {
                    const checkbox = document.getElementById(`color${color.charAt(0).toUpperCase() + color.slice(1)}`);
                    if (checkbox) checkbox.checked = true;
                });
            }

            const minPrice = params.get('minPrice');
            if (minPrice) document.getElementById('minPrice').value = minPrice;

            const maxPrice = params.get('maxPrice');
            if (maxPrice) document.getElementById('maxPrice').value = maxPrice;

            const sort = params.get('sort');
            if (sort) document.getElementById('sortSelect').value = sort;
        }

        // Handle Enter key in search input
        document.getElementById('searchInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                applyFilters();
            }
        });
    </script>




